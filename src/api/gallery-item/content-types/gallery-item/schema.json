{
  "kind": "collectionType",
  "collectionName": "gallery_item",
  "info": {
    "singularName": "gallery-item",
    "pluralName": "gallery-items",
    "displayName": "Gallery Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "src": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "alt": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "gallery_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gallery-category.gallery-category",
      "inversedBy": "gallery_items"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  }
}